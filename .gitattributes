# Enforce LF line endings in the repository for all text files.
# This overrides individual developer core.autocrlf settings.
* text=auto eol=lf

# Explicitly LF — source files
*.ts        text eol=lf
*.html      text eol=lf
*.scss      text eol=lf
*.css       text eol=lf
*.less      text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.sh        text eol=lf
*.sql       text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf

# Binary — never touch line endings
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.otf       binary
*.pdf       binary
*.zip       binary
*.tgz       binary
*.xlsm      binary
